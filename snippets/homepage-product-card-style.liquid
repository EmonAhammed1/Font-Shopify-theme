{% comment %}
  Homepage Product Card Styling (Pixel-perfect matching 2nd image layout & brand colors)
{% endcomment %}

<style>
  /* 1. Hide top plain headings (Franchard Trousers, etc.) rendered above each image */
  .section-content-wrapper > [data-block-type="group"] > [data-block-type="text"],
  [id*="section"] [data-block-type="group"] > [data-block-type="text"],
  .section-content-wrapper > div > [data-block-type="text"] {
    display: none !important;
  }

  /* 2. Style each product column as an elegant elevated card */
  .section-content-wrapper > [data-block-type="group"],
  [id*="section"] [data-block-type="group"] {
    background: #FAF8F5 !important;
    border: 1px solid #E6DFD5 !important;
    border-radius: 14px !important;
    padding: 0 0 16px 0 !important;
    overflow: hidden !important;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06) !important;
    transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), border-color 0.3s ease !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
  }

  .section-content-wrapper > [data-block-type="group"]:hover,
  [id*="section"] [data-block-type="group"]:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 12px 30px rgba(93, 43, 9, 0.15) !important;
    border-color: #5d2b09 !important;
  }

  /* 3. Product Card element resets inside column */
  .section-content-wrapper product-card,
  .section-content-wrapper .product-card__content,
  [id*="section"] product-card,
  [id*="section"] .product-card__content {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* 4. Image gallery styling */
  .section-content-wrapper card-gallery,
  .section-content-wrapper .card-gallery,
  [id*="section"] card-gallery {
    border-radius: 14px 14px 0 0 !important;
    overflow: hidden !important;
    background: #FFFFFF !important;
    margin-bottom: 14px !important;
    width: 100% !important;
  }

  .section-content-wrapper card-gallery img,
  .section-content-wrapper .card-gallery img,
  [id*="section"] card-gallery img {
    border-radius: 14px 14px 0 0 !important;
    object-fit: cover !important;
    transition: transform 0.4s ease !important;
  }

  .section-content-wrapper [data-block-type="group"]:hover card-gallery img,
  [id*="section"] [data-block-type="group"]:hover card-gallery img {
    transform: scale(1.03) !important;
  }

  /* 5. Product Title - BOLD, prominent, large font like Image 2 */
  .section-content-wrapper product-title,
  .section-content-wrapper product-title a,
  .section-content-wrapper .product-card-gallery__title-placeholder a,
  [id*="section"] product-title,
  [id*="section"] product-title a {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #170b02 !important;
    line-height: 1.35 !important;
    letter-spacing: -0.01em !important;
    text-decoration: none !important;
    display: block !important;
    padding: 0 16px !important;
    margin-bottom: 6px !important;
    font-family: var(--font-body--family), sans-serif !important;
  }

  /* 6. Price styling - Clean & prominent */
  .section-content-wrapper price-component,
  .section-content-wrapper .price,
  .section-content-wrapper [data-block-type="price"],
  [id*="section"] price-component,
  [id*="section"] [data-block-type="price"] {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #170b02 !important;
    padding: 0 16px !important;
    margin-bottom: 12px !important;
  }

  /* Hide duplicate price elements if present */
  .section-content-wrapper [data-block-type="price"] ~ [data-block-type="price"],
  [id*="section"] [data-block-type="price"] ~ [data-block-type="price"] {
    display: none !important;
  }

  /* 7. Add to Bag Button - matching Image 2 style with store primary color #5d2b09 */
  .font-add-to-bag-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: calc(100% - 32px) !important;
    margin: 6px 16px 0 16px !important;
    padding: 13px 16px !important;
    background-color: #5d2b09 !important;
    color: #f7f1ed !important;
    border: none !important;
    border-radius: 8px !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: background-color 0.25s ease, transform 0.15s ease, box-shadow 0.25s ease !important;
    box-shadow: 0 3px 10px rgba(93, 43, 9, 0.22) !important;
  }

  .font-add-to-bag-btn:hover {
    background-color: #98591b !important;
    color: #ffffff !important;
    transform: translateY(-1px) scale(1.01) !important;
    box-shadow: 0 5px 15px rgba(152, 89, 27, 0.3) !important;
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper product-title,
    .section-content-wrapper product-title a {
      font-size: 1rem !important;
    }
    .font-add-to-bag-btn {
      font-size: 0.8rem !important;
      padding: 11px 12px !important;
    }
  }
</style>

<script>
  (function () {
    function setupCards() {
      // Find groups containing product-card
      const groups = document.querySelectorAll('[data-block-type="group"]');
      groups.forEach(group => {
        const card = group.querySelector('product-card');
        if (!card) return;

        if (group.querySelector('.font-add-to-bag-btn')) return;

        const priceEl = group.querySelector('price-component, .price, [data-block-type="price"]');
        let priceText = '';
        if (priceEl) {
          const rawPrice = priceEl.innerText.trim();
          const match = rawPrice.match(/([£$€]\s*[\d,]+(?:\.\d{2})?)/);
          if (match) {
            priceText = match[1];
          }
        }

        const linkEl = group.querySelector('a.product-card__link, a[href*="/products/"]');
        const href = linkEl ? linkEl.getAttribute('href') : '#';

        const btn = document.createElement('a');
        btn.href = href;
        btn.className = 'font-add-to-bag-btn';
        btn.innerHTML = priceText ? `ADD TO BAG &nbsp;|&nbsp; ${priceText}` : 'ADD TO BAG';

        group.appendChild(btn);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCards);
    } else {
      setupCards();
    }

    setInterval(setupCards, 500);
  })();
</script>
