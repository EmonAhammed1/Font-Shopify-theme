{% comment %}
  Homepage Product Card Styling (Matching Image 2 card style with brand colors)
{% endcomment %}

<style>
  /* 1. Hide top headings above cards in section_kx8Tk3 */
  #shopify-section-section_kx8Tk3 [data-block-type="text"] {
    display: none !important;
  }

  /* 2. Container card styling for each product column */
  #shopify-section-section_kx8Tk3 [data-block-type="group"] {
    background: #FAF8F5 !important;
    border: 1px solid #EAE4DC !important;
    border-radius: 12px !important;
    padding: 0 0 16px 0 !important;
    overflow: hidden !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05) !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
  }

  #shopify-section-section_kx8Tk3 [data-block-type="group"]:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 8px 25px rgba(93, 43, 9, 0.14) !important;
  }

  /* 3. Product Card element resets */
  #shopify-section-section_kx8Tk3 product-card,
  #shopify-section-section_kx8Tk3 .product-card__content {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    width: 100% !important;
    padding: 0 !important;
  }

  /* 4. Image gallery styling */
  #shopify-section-section_kx8Tk3 card-gallery,
  #shopify-section-section_kx8Tk3 .card-gallery {
    border-radius: 12px 12px 0 0 !important;
    overflow: hidden !important;
    background: #FFFFFF !important;
    margin-bottom: 14px !important;
    width: 100% !important;
  }

  #shopify-section-section_kx8Tk3 card-gallery img,
  #shopify-section-section_kx8Tk3 .card-gallery img {
    border-radius: 12px 12px 0 0 !important;
    object-fit: cover !important;
  }

  /* 5. Product Title - BOLD, prominent, large font like Image 2 */
  #shopify-section-section_kx8Tk3 product-title,
  #shopify-section-section_kx8Tk3 product-title a,
  #shopify-section-section_kx8Tk3 .product-card-gallery__title-placeholder a {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #170b02 !important;
    line-height: 1.3 !important;
    letter-spacing: -0.01em !important;
    text-decoration: none !important;
    display: block !important;
    padding: 0 16px !important;
    margin-bottom: 6px !important;
    font-family: var(--font-body--family), sans-serif !important;
  }

  /* 6. Price styling */
  #shopify-section-section_kx8Tk3 price-component,
  #shopify-section-section_kx8Tk3 .price,
  #shopify-section-section_kx8Tk3 [data-block-type="price"] {
    font-size: 1.02rem !important;
    font-weight: 700 !important;
    color: #170b02 !important;
    padding: 0 16px !important;
    margin-bottom: 12px !important;
  }

  /* 7. Hide duplicate price elements if present */
  #shopify-section-section_kx8Tk3 [data-block-type="price"] ~ [data-block-type="price"] {
    display: none !important;
  }

  /* 8. Add to Bag Button - matching Image 2 style with store primary color #5d2b09 */
  #shopify-section-section_kx8Tk3 .font-add-to-bag-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: calc(100% - 32px) !important;
    margin: 4px 16px 0 16px !important;
    padding: 12px 16px !important;
    background-color: #5d2b09 !important;
    color: #f7f1ed !important;
    border: none !important;
    border-radius: 6px !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: background-color 0.25s ease, transform 0.15s ease !important;
    box-shadow: 0 2px 6px rgba(93, 43, 9, 0.2) !important;
  }

  #shopify-section-section_kx8Tk3 .font-add-to-bag-btn:hover {
    background-color: #98591b !important;
    color: #ffffff !important;
    transform: scale(1.01) !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-section_kx8Tk3 product-title,
    #shopify-section-section_kx8Tk3 product-title a {
      font-size: 1rem !important;
    }
    #shopify-section-section_kx8Tk3 .font-add-to-bag-btn {
      font-size: 0.8rem !important;
      padding: 10px 12px !important;
    }
  }
</style>

<script>
  (function () {
    function setupCards() {
      const section = document.getElementById('shopify-section-section_kx8Tk3');
      if (!section) return;

      const groups = section.querySelectorAll('[data-block-type="group"]');
      groups.forEach(group => {
        const card = group.querySelector('product-card');
        if (!card) return;

        if (group.querySelector('.font-add-to-bag-btn')) return;

        const priceEl = group.querySelector('price-component, .price, [data-block-type="price"]');
        let priceText = '';
        if (priceEl) {
          const rawPrice = priceEl.innerText.trim();
          const match = rawPrice.match(/([£$€]\s*[\d,]+(?:\.\d{2})?)/);
          if (match) {
            priceText = match[1];
          }
        }

        const linkEl = group.querySelector('a.product-card__link, a[href*="/products/"]');
        const href = linkEl ? linkEl.getAttribute('href') : '#';

        const btn = document.createElement('a');
        btn.href = href;
        btn.className = 'font-add-to-bag-btn';
        btn.innerHTML = priceText ? `ADD TO BAG &nbsp;|&nbsp; ${priceText}` : 'ADD TO BAG';

        group.appendChild(btn);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCards);
    } else {
      setupCards();
    }

    const section = document.getElementById('shopify-section-section_kx8Tk3');
    if (section) {
      const observer = new MutationObserver(setupCards);
      observer.observe(section, { childList: true, subtree: true });
    }
  })();
</script>
