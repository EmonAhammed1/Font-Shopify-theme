{% comment %}
  Marquee Banner Section for FONT Boulderwear
  Renders an infinite smooth-scrolling banner right below the Hero section with full Theme Customizer options.
{% endcomment %}

<div
  class="marquee-banner-section color-{{ section.settings.color_scheme }}"
  id="MarqueeBanner-{{ section.id }}"
  style="
    --marquee-bg: {{ section.settings.background_color }};
    --marquee-text-color: {{ section.settings.text_color }};
    --marquee-icon-color: {{ section.settings.icon_color }};
    --marquee-font-size: {{ section.settings.font_size }}px;
    --marquee-font-weight: {{ section.settings.font_weight }};
    --marquee-letter-spacing: {{ section.settings.letter_spacing }}px;
    --marquee-text-transform: {{ section.settings.text_transform }};
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.gap }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="marquee-banner {% if section.settings.pause_on_hover %}marquee-banner--pause-on-hover{% endif %}">
    <div class="marquee-banner__track {% if section.settings.direction == 'left_to_right' %}marquee-banner__track--reverse{% endif %}">
      {% for i in (1..4) %}
        <div class="marquee-banner__content">
          {% for block in section.blocks %}
            <div class="marquee-banner__item" {{ block.shopify_attributes }}>
              {% if block.settings.icon != 'none' %}
                <span class="marquee-banner__icon">
                  {% case block.settings.icon %}
                    {% when 'lightning' %}⚡
                    {% when 'mountain' %}⛰️
                    {% when 'leaf' %}🌿
                    {% when 'rocket' %}🚀
                    {% when 'climber' %}🧗‍♂️
                    {% when 'tree' %}🌲
                    {% when 'star' %}★
                    {% when 'fire' %}🔥
                  {% endcase %}
                </span>
              {% endif %}
              <span class="marquee-banner__text">{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .marquee-banner-section {
    width: 100%;
    overflow: hidden;
    background: var(--marquee-bg, #0f172a);
    color: var(--marquee-text-color, #ffffff);
    padding-top: var(--padding-top, 14px);
    padding-bottom: var(--padding-bottom, 14px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .marquee-banner {
    display: flex;
    width: 100%;
    overflow: hidden;
    user-select: none;
  }

  .marquee-banner--pause-on-hover:hover .marquee-banner__track {
    animation-play-state: paused;
  }

  .marquee-banner__track {
    display: flex;
    width: max-content;
    animation: marqueeScroll var(--marquee-speed, 25s) linear infinite;
    will-change: transform;
  }

  .marquee-banner__track--reverse {
    animation-direction: reverse;
  }

  .marquee-banner__content {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap, 40px);
    padding-right: var(--marquee-gap, 40px);
    flex-shrink: 0;
  }

  .marquee-banner__item {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-size: var(--marquee-font-size, 16px);
    font-weight: var(--marquee-font-weight, 700);
    letter-spacing: var(--marquee-letter-spacing, 1px);
    text-transform: var(--marquee-text-transform, uppercase);
    color: var(--marquee-text-color, #ffffff);
  }

  .marquee-banner__icon {
    font-size: 1.1em;
    color: var(--marquee-icon-color, #38bdf8);
    display: inline-flex;
    align-items: center;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-25%, 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee Banner",
  "tag": "section",
  "class": "marquee-banner-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#38bdf8"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "right_to_left",
          "label": "Right to Left (Default)"
        },
        {
          "value": "left_to_right",
          "label": "Left to Right"
        }
      ],
      "default": "right_to_left"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed Duration",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semi Bold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        },
        {
          "value": "800",
          "label": "Extra Bold (800)"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "none",
          "label": "Normal Case"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "lightning",
              "label": "⚡ Lightning"
            },
            {
              "value": "mountain",
              "label": "⛰️ Mountain"
            },
            {
              "value": "leaf",
              "label": "🌿 Leaf"
            },
            {
              "value": "rocket",
              "label": "🚀 Rocket"
            },
            {
              "value": "climber",
              "label": "🧗‍♂️ Climber"
            },
            {
              "value": "tree",
              "label": "🌲 Tree"
            },
            {
              "value": "star",
              "label": "★ Star"
            },
            {
              "value": "fire",
              "label": "🔥 Fire"
            }
          ],
          "default": "lightning"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "PREMIUM BOULDERING GEAR"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Banner",
      "blocks": [
        {
          "type": "marquee_item",
          "settings": {
            "icon": "lightning",
            "text": "PREMIUM BOULDERING GEAR"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "icon": "mountain",
            "text": "DESIGNED FOR THE CLIMB"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "icon": "leaf",
            "text": "SUSTAINABLE & DURABLE FABRICS"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "icon": "rocket",
            "text": "FREE WORLDWIDE SHIPPING OVER $100"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "icon": "climber",
            "text": "TESTED BY PRO CLIMBERS"
          }
        },
        {
          "type": "marquee_item",
          "settings": {
            "icon": "tree",
            "text": "FONT BOULDERWEAR 2026 COLLECTION"
          }
        }
      ]
    }
  ]
}
{% endschema %}
