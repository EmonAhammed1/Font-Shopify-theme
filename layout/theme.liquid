<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <style>
      /* Styling for hero_Ha3FDU section text */
      [id*="hero_Ha3FDU"] h1,
      [id*="hero_Ha3FDU"] h2,
      [id*="hero_Ha3FDU"] h3,
      [id*="hero_Ha3FDU"] p,
      [id*="hero_Ha3FDU"] .text-block {
        font-size: clamp(1.4rem, 2.5vw, 2.25rem) !important;
        font-weight: 700 !important;
        text-align: center !important;
        color: #ffffff !important;
        line-height: 1.5 !important;
        max-width: 950px !important;
        margin: 0 auto !important;
      }

      /* Fontainebleau hero text section line spacing & reveal animation */
      [id*="hero_pjNAy4"] h4,
      [id*="hero_pjNAy4"] .text-block,
      [id*="hero_pjNAy4"] .custom-typography {
        line-height: 1.55 !important;
        --line-height: 1.55 !important;
      }

      /* Mobile Font Size Fix: Keep desktop large, but compact 1.45rem on mobile */
      @media screen and (max-width: 749px) {
        [id*="hero_pjNAy4"] h4,
        [id*="hero_pjNAy4"] .text-block,
        [id*="hero_pjNAy4"] [data-block-type="text"],
        [id*="hero_pjNAy4"] [data-block-type="text"] * {
          font-size: 1.45rem !important;
          line-height: 1.45 !important;
          --font-size: 1.45rem !important;
          padding-left: 8px !important;
          padding-right: 8px !important;
        }

        [id*="hero_pjNAy4"] [data-block-type="image"] img {
          max-width: 130px !important;
        }
      }

      /* Hidden initially before scrolling to this section */
      [id*="hero_pjNAy4"] .text-block,
      [id*="hero_pjNAy4"] [data-block-type="text"] {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }

      [id*="hero_pjNAy4"] [data-block-type="image"],
      [id*="hero_pjNAy4"] .button {
        opacity: 0;
        transform: translateY(30px) scale(0.94);
        transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.25s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
        will-change: opacity, transform;
      }

      /* Revealed active state when scrolled into view */
      [id*="hero_pjNAy4"].section-revealed .text-block,
      [id*="hero_pjNAy4"].section-revealed [data-block-type="text"] {
        opacity: 1 !important;
        transform: translateY(0) !important;
      }

      [id*="hero_pjNAy4"].section-revealed [data-block-type="image"],
      [id*="hero_pjNAy4"].section-revealed .button {
        opacity: 1 !important;
        transform: translateY(0) scale(1) !important;
      }

      /* High-Visibility Footer Newsletter Email Input */
      footer .email-signup__input-group,
      footer .email-signup-block {
        margin-top: 12px !important;
      }

      footer .email-signup__input,
      footer input[type="email"] {
        background: rgba(255, 255, 255, 0.25) !important;
        border: 1.5px solid rgba(255, 255, 255, 0.65) !important;
        border-radius: 40px !important;
        color: #ffffff !important;
        padding: 12px 48px 12px 22px !important;
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        width: 100% !important;
        backdrop-filter: blur(8px) !important;
        transition: all 0.25s ease !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15) !important;
      }

      footer .email-signup__input::placeholder,
      footer input[type="email"]::placeholder {
        color: rgba(255, 255, 255, 0.9) !important;
        font-size: 0.9rem !important;
        opacity: 1 !important;
      }

      footer .email-signup__input:focus,
      footer input[type="email"]:focus {
        background: rgba(255, 255, 255, 0.38) !important;
        border-color: #ffffff !important;
        outline: none !important;
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.45) !important;
        color: #ffffff !important;
      }

      footer .email-signup__button {
        color: #ffffff !important;
        opacity: 0.95 !important;
        transition: transform 0.2s ease, opacity 0.2s ease !important;
      }

      footer .email-signup__button-icon,
      footer .email-signup__button svg,
      footer .email-signup__button-icon * {
        fill: #ffffff !important;
        stroke: #ffffff !important;
        color: #ffffff !important;
      }

      footer .email-signup__button:hover {
        transform: translateX(3px) scale(1.1) !important;
        opacity: 1 !important;
      }

      /* ========================================================
         COMPACT PIXEL PERFECT PRODUCT CARD (NO EXCESSIVE GAPS)
         ======================================================== */
      product-card,
      .product-card {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
      }

      .product-card__content,
      .product-grid__card {
        background-color: #F7F3EE !important; /* Cream card background */
        border-radius: 6px !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        height: 100% !important;
        padding: 0 !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
        transition: transform 0.25s ease, box-shadow 0.25s ease !important;
      }

      .product-card:hover .product-card__content {
        transform: translateY(-4px) !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
      }

      /* Image area inside card - Strictly Equal Height for All Images (Tall Portrait 450px) */
      product-card-gallery,
      .product-card-gallery,
      .product-card-gallery__carousel,
      .product-card-gallery__media,
      .product-card media-gallery,
      .product-card slideshow-component,
      .product-card .media,
      .product-card [class*="media"],
      .product-card-gallery [class*="media"] {
        position: relative !important;
        background-color: #F7F3EE !important;
        padding: 0 !important;
        width: 100% !important;
        height: 450px !important;
        min-height: 450px !important;
        max-height: 450px !important;
        display: block !important;
        overflow: hidden !important;
      }

      .product-card-gallery img,
      .product-card media-gallery img,
      .product-card .media img,
      .product-card img,
      product-card img {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center top !important;
        max-height: none !important;
        display: block !important;
        transition: transform 0.4s ease !important;
      }

      @media screen and (max-width: 749px) {
        product-card-gallery,
        .product-card-gallery,
        .product-card-gallery__carousel,
        .product-card-gallery__media,
        .product-card media-gallery,
        .product-card slideshow-component,
        .product-card .media,
        .product-card [class*="media"],
        .product-card-gallery [class*="media"] {
          height: 300px !important;
          min-height: 300px !important;
          max-height: 300px !important;
        }
      }

      .product-card:hover img {
        transform: scale(1.03) !important;
      }

      /* Title & Price text container - Guaranteed 20px Left Padding */
      .product-card [data-block-type="product-title"],
      .product-card [data-block-type="price"],
      .product-card .product-title,
      .product-card .price,
      .product-card .text-block,
      .product-card [data-block-type="product-title"] .text-block,
      .product-card [data-block-type="price"] .text-block {
        padding-left: 20px !important;
        padding-right: 20px !important;
        padding-inline: 20px !important;
        box-sizing: border-box !important;
        width: 100% !important;
      }

      .product-card [data-block-type="product-title"],
      .product-card .product-title {
        margin-top: 14px !important;
        margin-bottom: 2px !important;
      }

      .product-card [data-block-type="price"],
      .product-card .price {
        margin-bottom: 14px !important;
      }

      /* Title Typography - Elegant Semi-Bold 1.15rem (Not overly heavy) */
      .product-card product-title,
      .product-card .product-title,
      .product-card h2,
      .product-card h3,
      .product-card h4,
      .product-card a,
      .product-card .product-title a,
      .product-card [data-block-type="product-title"],
      .product-card [data-block-type="product-title"] *,
      .product-card [class*="title"] {
        font-size: 1.15rem !important;
        font-weight: 600 !important;
        color: #111111 !important;
        line-height: 1.35 !important;
        letter-spacing: -0.01em !important;
        text-decoration: none !important;
      }

      /* Price Typography - Clean 1.05rem, Semi-Bold */
      .product-card .price,
      .product-card .price-item,
      .product-card [data-block-type="price"],
      .product-card [data-block-type="price"] * {
        font-size: 1.05rem !important;
        font-weight: 600 !important;
        color: #444444 !important;
      }

      /* Bottom Full-Width CTA Button - Guaranteed White Text */
      button.custom-product-card__cta-btn,
      a.custom-product-card__cta-btn,
      .custom-product-card__cta-btn,
      .custom-product-card__view-details-btn,
      .custom-product-card__add-to-cart-btn {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        background-color: #D32F2F !important;
        color: #FFFFFF !important;
        padding: 12px 14px !important;
        font-size: 0.85rem !important;
        font-weight: 800 !important;
        letter-spacing: 0.06em !important;
        text-transform: uppercase !important;
        text-decoration: none !important;
        border: none !important;
        margin-top: auto !important;
        transition: background-color 0.25s ease !important;
      }

      button.custom-product-card__cta-btn *,
      a.custom-product-card__cta-btn *,
      a.custom-product-card__cta-btn:link,
      a.custom-product-card__cta-btn:visited,
      .custom-product-card__cta-btn .btn-text {
        color: #FFFFFF !important;
        text-decoration: none !important;
      }

      .custom-product-card__cta-btn:hover,
      .custom-product-card__cta-btn:hover * {
        background-color: #B71C1C !important;
        color: #FFFFFF !important;
      }

      .custom-product-card__cta-btn--disabled {
        background-color: #D32F2F !important;
        opacity: 0.65 !important;
      }

      /* Single Product Page Title, Price & Description Prominence Boost */
      .product-information [data-block-type="product-title"] h1,
      .product-information [data-block-type="product-title"] h2,
      .product-information [data-block-type="product-title"] .text-block,
      ._product-details [data-block-type="product-title"] *,
      .product-information .product__title,
      .product-information h1.product-title {
        font-size: 2.2rem !important;
        font-weight: 800 !important;
        color: #111111 !important;
        line-height: 1.25 !important;
        letter-spacing: -0.02em !important;
        margin-bottom: 8px !important;
      }

      .product-information [data-block-type="price"],
      .product-information [data-block-type="price"] *,
      ._product-details [data-block-type="price"] *,
      .product-information .price-item,
      .product-information .price {
        font-size: 1.65rem !important;
        font-weight: 800 !important;
        color: #D32F2F !important;
        margin-top: 4px !important;
      }

      .product-information [data-block-type="product-description"],
      .product-information [data-block-type="product-description"] *,
      .product-information [data-block-type="product-description"] p,
      .product-information [data-block-type="product-description"] li,
      .product-information [data-block-type="product-description"] span,
      ._product-details [data-block-type="product-description"] *,
      ._product-details [data-block-type="product-description"] p,
      ._product-details [data-block-type="product-description"] li,
      .product__description,
      .product__description *,
      .product__description p,
      .product__description li {
        font-size: 1.35rem !important;
        font-weight: 450 !important;
        line-height: 1.7 !important;
        color: #111111 !important;
      }

      @media screen and (max-width: 749px) {
        .product-information [data-block-type="product-title"] h1,
        .product-information [data-block-type="product-title"] h2,
        .product-information [data-block-type="product-title"] .text-block,
        ._product-details [data-block-type="product-title"] * {
          font-size: 1.65rem !important;
        }

        .product-information [data-block-type="price"],
        .product-information [data-block-type="price"] *,
        ._product-details [data-block-type="price"] * {
          font-size: 1.4rem !important;
        }

        .product-information [data-block-type="product-description"],
        .product-information [data-block-type="product-description"] *,
        .product-information [data-block-type="product-description"] p,
        .product-information [data-block-type="product-description"] li,
        ._product-details [data-block-type="product-description"] *,
        ._product-details [data-block-type="product-description"] p,
        ._product-details [data-block-type="product-description"] li,
        .product__description,
        .product__description *,
        .product__description p,
        .product__description li {
          font-size: 1.18rem !important;
          line-height: 1.6 !important;
        }
      }
    </style>

    <script>
      (function () {
        function initScrollReveal() {
          const section = document.querySelector('[id*="hero_pjNAy4"]');
          if (!section) return;

          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                section.classList.add('section-revealed');
                observer.unobserve(section);
              }
            });
          }, {
            threshold: 0.2
          });

          observer.observe(section);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveal);
        } else {
          initScrollReveal();
        }

        /* Instant AJAX Add To Cart Script for Single-Variant Cards */
        document.addEventListener('submit', function(e) {
          const form = e.target.closest('[data-type="add-to-cart-form"]');
          if (!form) return;

          e.preventDefault();
          const btn = form.querySelector('.custom-product-card__add-to-cart-btn');
          const btnText = btn ? btn.querySelector('.btn-text') : null;
          const originalText = btnText ? btnText.textContent : 'ADD TO BAG';

          if (btnText) btnText.textContent = 'ADDING...';
          if (btn) btn.disabled = true;

          const formData = new FormData(form);

          fetch('/cart/add.js', {
            method: 'POST',
            body: formData
          })
          .then(res => res.json())
          .then(data => {
            if (btnText) btnText.textContent = 'ADDED ✓';
            
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
            
            fetch('/cart.js')
              .then(response => response.json())
              .then(cart => {
                document.querySelectorAll('.cart-count, [data-cart-count], .header__cart-count, .cart-count-bubble').forEach(el => {
                  el.textContent = cart.item_count;
                  el.style.display = 'inline-flex';
                });

                const cartDrawer = document.querySelector('cart-drawer, #cart-drawer, .cart-drawer');
                if (cartDrawer && typeof cartDrawer.open === 'function') {
                  cartDrawer.open();
                } else if (cartDrawer) {
                  cartDrawer.classList.add('active', 'is-open');
                }
              });

            setTimeout(() => {
              if (btnText) btnText.textContent = originalText;
              if (btn) btn.disabled = false;
            }, 2000);
          })
          .catch(err => {
            console.error('Error adding to cart:', err);
            if (btnText) btnText.textContent = originalText;
            if (btn) btn.disabled = false;
          });
        });
      })();
    </script>
  </body>
</html>
