{% doc %}
  @name Custom Premium Newsletter Banner
  @description Super premium responsive newsletter subscription banner block
{% enddoc %}

{% assign block_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .custom-newsletter-section-{{ block_id }} {
    display: block;
    width: 100vw !important;
    max-width: 100vw !important;
    position: relative !important;
    left: 50% !important;
    right: 50% !important;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    background: linear-gradient(135deg, #0f0f11 0%, #161619 50%, #1f090b 100%);
    padding: 90px 20px !important;
    text-align: center;
    box-sizing: border-box !important;
    overflow: hidden;
  }

  .custom-newsletter-section-{{ block_id }}::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(211, 47, 47, 0.28) 0%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .custom-newsletter__card-{{ block_id }} {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    background: rgba(22, 22, 25, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(211, 47, 47, 0.35);
    border-radius: 24px;
    padding: 55px 40px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 45px rgba(211, 47, 47, 0.2);
    position: relative;
    z-index: 2;
  }

  .custom-newsletter__badge-{{ block_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(211, 47, 47, 0.15);
    color: #ff5252;
    border: 1px solid rgba(211, 47, 47, 0.4);
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .custom-newsletter__heading-{{ block_id }} {
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .custom-newsletter__subtext-{{ block_id }} {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: #bbbbbb;
    margin: 0;
    line-height: 1.6;
    max-width: 600px;
  }

  .custom-newsletter__form-{{ block_id }} {
    width: 100%;
    max-width: 580px;
    margin-top: 10px;
  }

  .custom-newsletter__input-group-{{ block_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    width: 100%;
    background: rgba(255, 255, 255, 0.07);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    padding: 6px 6px 6px 22px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .custom-newsletter__input-group-{{ block_id }}:focus-within {
    border-color: #d32f2f;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 30px rgba(211, 47, 47, 0.45);
  }

  .custom-newsletter__input-{{ block_id }} {
    flex: 1;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    color: #ffffff !important;
    font-size: 1rem !important;
    font-weight: 500 !important;
    padding: 10px 0 !important;
  }

  .custom-newsletter__input-{{ block_id }}::placeholder {
    color: rgba(255, 255, 255, 0.6) !important;
    font-size: 0.95rem !important;
  }

  .custom-newsletter__submit-btn-{{ block_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #d32f2f;
    color: #ffffff;
    border: none;
    padding: 15px 32px;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(211, 47, 47, 0.4);
  }

  .custom-newsletter__submit-btn-{{ block_id }}:hover {
    background: #b71c1c;
    transform: scale(1.04);
    box-shadow: 0 10px 30px rgba(211, 47, 47, 0.6);
  }

  .custom-newsletter__trust-{{ block_id }} {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .custom-newsletter__success-msg-{{ block_id }} {
    color: #4caf50;
    font-weight: 700;
    font-size: 1.05rem;
    margin-top: 10px;
  }

  @media screen and (max-width: 640px) {
    .custom-newsletter__input-group-{{ block_id }} {
      flex-direction: column;
      border-radius: 20px;
      padding: 12px;
      gap: 12px;
      background: transparent;
      border: none;
      box-shadow: none;
    }

    .custom-newsletter__input-{{ block_id }} {
      width: 100% !important;
      background: rgba(255, 255, 255, 0.1) !important;
      border: 1.5px solid rgba(255, 255, 255, 0.2) !important;
      border-radius: 40px !important;
      padding: 14px 20px !important;
      text-align: center !important;
    }

    .custom-newsletter__submit-btn-{{ block_id }} {
      width: 100%;
      border-radius: 40px;
      padding: 15px 20px;
    }

    .custom-newsletter__card-{{ block_id }} {
      padding: 40px 20px;
    }
  }
{% endstyle %}

<div class="custom-newsletter-section-{{ block_id }}">
  <div class="custom-newsletter__card-{{ block_id }}">
    <div class="custom-newsletter__badge-{{ block_id }}">
      ⚡ JOIN THE COMMUNITY & GET 15% OFF
    </div>

    <h2 class="custom-newsletter__headline-{{ block_id }}">
      Join The FONT Bouldering Movement
    </h2>

    <p class="custom-newsletter__subtext-{{ block_id }}">
      Subscribe to receive exclusive early access to new boulderwear drops, climbing tips, and special discounts directly to your inbox.
    </p>

    <div class="custom-newsletter__form-{{ block_id }}">
      {%- form 'customer', id: 'CustomNewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.posted_successfully? -%}
          <div class="custom-newsletter__success-msg-{{ block_id }}">
            🎉 Thank you for subscribing! Check your inbox for your 15% discount code.
          </div>
        {%- else -%}
          <div class="custom-newsletter__input-group-{{ block_id }}">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail-{{ block_id }}"
              class="custom-newsletter__input-{{ block_id }}"
              value="{{ form.email }}"
              placeholder="Enter your email address..."
              aria-label="Email address"
              required
              autocomplete="email"
            >
            <button
              type="submit"
              class="custom-newsletter__submit-btn-{{ block_id }}"
              name="commit"
            >
              SUBSCRIBE NOW &rarr;
            </button>
          </div>

          {%- if form.errors -%}
            <div style="color: #ff5252; margin-top: 8px; font-size: 0.9rem;">
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="custom-newsletter__trust-{{ block_id }}">
      🔒 100% free, no spam. Unsubscribe anytime with one click.
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Premium Newsletter",
  "settings": []
}
{% endschema %}
