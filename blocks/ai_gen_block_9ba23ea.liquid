{% doc %}
  @prompt
    Marquee-style Image Carousel: continuous right-to-left auto-scroll, pause on hover, mouse drag, touch swipe, click to /collections/all.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    margin: 0 auto;
    padding-block: {{ block.settings.section_padding | default: 10 }}px;
  }

  .ai-image-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.carousel_height | default: 420 }}px;
    overflow: hidden;
  }

  .ai-image-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap | default: 16 }}px;
    height: 100%;
    will-change: transform;
    /* NO transition here — JS controls transform directly */
  }

  .ai-image-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 auto;
    height: 100%;
    position: relative;
    border-radius: {{ block.settings.slide_border_radius | default: 12 }}px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}:hover {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
    transform: translateY(-3px) scale(1.01);
  }

  .ai-image-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .ai-image-carousel-container-{{ ai_gen_id }} {
      height: {{ block.settings.carousel_height_mobile | default: 280 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <image-carousel-{{ ai_gen_id }} class="ai-image-carousel-container-{{ ai_gen_id }}">
    <div class="ai-image-carousel-track-{{ ai_gen_id }}">

      {% if block.settings.image_1 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_1 | image_url: width: 1200 }}" alt="{{ block.settings.image_1.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% else %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <div class="ai-image-carousel-placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>
        </a>
      {% endif %}

      {% if block.settings.image_2 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_2 | image_url: width: 1200 }}" alt="{{ block.settings.image_2.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% endif %}

      {% if block.settings.image_3 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_3 | image_url: width: 1200 }}" alt="{{ block.settings.image_3.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% endif %}

      {% if block.settings.image_4 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_4 | image_url: width: 1200 }}" alt="{{ block.settings.image_4.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% endif %}

      {% if block.settings.image_5 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_5 | image_url: width: 1200 }}" alt="{{ block.settings.image_5.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% endif %}

      {% if block.settings.image_6 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_6 | image_url: width: 1200 }}" alt="{{ block.settings.image_6.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% endif %}

      {% if block.settings.image_7 != blank %}
        <a href="{{ block.settings.link_url | default: '/collections/all' }}" class="ai-image-carousel-slide-{{ ai_gen_id }}">
          <img src="{{ block.settings.image_7 | image_url: width: 1200 }}" alt="{{ block.settings.image_7.alt | escape }}" loading="lazy" draggable="false">
        </a>
      {% endif %}

    </div>
  </image-carousel-{{ ai_gen_id }}>
</div>

<script>
(function() {
  class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.track        = this.querySelector('.ai-image-carousel-track-{{ ai_gen_id }}');
      this.wrapper      = this.closest('.ai-image-carousel-{{ ai_gen_id }}');

      this.scrollSpeed  = {{ block.settings.scroll_speed | default: 60 }};   // px per second
      this.slideGap     = {{ block.settings.slide_gap | default: 16 }};
      this.slidesToShow = this._getSlidesToShow();
      this.position     = 0;
      this.isPaused     = false;
      this.isDragging   = false;
      this.hasDragged   = false;
      this.lastTime     = null;
      this.loopWidth    = 0;

      // Wait for fonts/images then init
      requestAnimationFrame(() => { this._init(); });
    }

    _getSlidesToShow() {
      return window.innerWidth < 750
        ? ({{ block.settings.slides_to_show_mobile | default: 1 }})
        : ({{ block.settings.slides_to_show_desktop | default: 4 }});
    }

    _getSlideWidth() {
      const gap = this.slideGap;
      const n   = this.slidesToShow;
      return (this.offsetWidth - gap * (n - 1)) / n;
    }

    _init() {
      const origSlides = Array.from(this.track.querySelectorAll('.ai-image-carousel-slide-{{ ai_gen_id }}'));
      if (origSlides.length === 0) return;

      const slideW = this._getSlideWidth();
      const gap    = this.slideGap;

      // Set fixed width on each slide
      origSlides.forEach(s => {
        s.style.width    = slideW + 'px';
        s.style.minWidth = slideW + 'px';
        s.style.flex     = '0 0 ' + slideW + 'px';
      });

      // Calculate total width of one real set
      this.loopWidth = origSlides.length * (slideW + gap);

      // Clone slides to fill at least 3x viewport width for seamless loop
      const needed = Math.ceil((this.offsetWidth * 3) / this.loopWidth) + 1;
      for (let i = 0; i < needed; i++) {
        origSlides.forEach(s => {
          const clone = s.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('tabindex', '-1');
          this.track.appendChild(clone);
        });
      }

      // Remove transition (JS controls position)
      this.track.style.transition = 'none';

      this._setupHover();
      this._setupMouseDrag();
      this._setupTouchSwipe();
      this._startRaf();

      // Recalculate on resize
      window.addEventListener('resize', this._onResize.bind(this));
    }

    _onResize() {
      clearTimeout(this._resizeTimer);
      this._resizeTimer = setTimeout(() => {
        this.slidesToShow = this._getSlidesToShow();
        // Recalculate slide widths
        const slideW = this._getSlideWidth();
        const gap    = this.slideGap;
        const slides = Array.from(this.track.querySelectorAll('.ai-image-carousel-slide-{{ ai_gen_id }}'));
        slides.forEach(s => {
          s.style.width    = slideW + 'px';
          s.style.minWidth = slideW + 'px';
          s.style.flex     = '0 0 ' + slideW + 'px';
        });
        const origCount = {{ block.settings.image_1 != blank ? 1 : 0 }}
          + {{ block.settings.image_2 != blank ? 1 : 0 }}
          + {{ block.settings.image_3 != blank ? 1 : 0 }}
          + {{ block.settings.image_4 != blank ? 1 : 0 }}
          + {{ block.settings.image_5 != blank ? 1 : 0 }}
          + {{ block.settings.image_6 != blank ? 1 : 0 }}
          + {{ block.settings.image_7 != blank ? 1 : 0 }};
        this.loopWidth = origCount * (slideW + gap);
        if (this.position > this.loopWidth) this.position = this.position % this.loopWidth;
      }, 200);
    }

    _startRaf() {
      const tick = (timestamp) => {
        if (!this.isDragging && !this.isPaused) {
          if (this.lastTime !== null) {
            const delta = timestamp - this.lastTime;
            this.position += (this.scrollSpeed * delta) / 1000;
            // Seamless loop
            if (this.loopWidth > 0 && this.position >= this.loopWidth) {
              this.position -= this.loopWidth;
            }
            this.track.style.transform = 'translateX(-' + this.position + 'px)';
          }
          this.lastTime = timestamp;
        } else {
          this.lastTime = null;
        }
        this._rafId = requestAnimationFrame(tick);
      };
      this._rafId = requestAnimationFrame(tick);
    }

    _setupHover() {
      this.addEventListener('mouseenter', () => { this.isPaused = true; });
      this.addEventListener('mouseleave', () => { this.isPaused = false; });
    }

    _setupMouseDrag() {
      let startX     = 0;
      let startPos   = 0;
      let dragDelta  = 0;

      const onMove = (e) => {
        if (e.buttons !== 1) { onUp(); return; }
        dragDelta = e.clientX - startX;
        if (Math.abs(dragDelta) > 5) this.hasDragged = true;
        let newPos = startPos - dragDelta;
        // Wrap within loopWidth
        if (this.loopWidth > 0) {
          newPos = ((newPos % this.loopWidth) + this.loopWidth) % this.loopWidth;
        }
        this.position = newPos;
        this.track.style.transform = 'translateX(-' + this.position + 'px)';
      };

      const onUp = () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.isPaused   = false;
        this.track.style.cursor = 'grab';
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('mouseup', onUp);
      };

      const onDown = (e) => {
        if (e.button !== 0) return;
        e.preventDefault();
        startX          = e.clientX;
        startPos        = this.position;
        dragDelta       = 0;
        this.hasDragged = false;
        this.isDragging = true;
        this.isPaused   = true;
        this.track.style.cursor = 'grabbing';
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);
      };

      // Block click after drag
      this.track.addEventListener('click', (e) => {
        if (this.hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          this.hasDragged = false;
        }
      }, true);

      this.track.style.userSelect = 'none';
      this.track.style.cursor     = 'grab';
      this.track.addEventListener('mousedown', onDown);
    }

    _setupTouchSwipe() {
      let touchStartX  = 0;
      let touchStartPos = 0;
      let touchHasDragged = false;

      this.track.addEventListener('touchstart', (e) => {
        touchStartX      = e.touches[0].clientX;
        touchStartPos    = this.position;
        touchHasDragged  = false;
        this.isPaused    = true;
      }, { passive: true });

      this.track.addEventListener('touchmove', (e) => {
        const dx = e.touches[0].clientX - touchStartX;
        if (Math.abs(dx) > 5) touchHasDragged = true;
        if (e.cancelable) e.preventDefault();
        let newPos = touchStartPos - dx;
        if (this.loopWidth > 0) {
          newPos = ((newPos % this.loopWidth) + this.loopWidth) % this.loopWidth;
        }
        this.position = newPos;
        this.track.style.transform = 'translateX(-' + this.position + 'px)';
      }, { passive: false });

      this.track.addEventListener('touchend', () => {
        this.isPaused = false;
      });

      this.track.addEventListener('click', (e) => {
        if (touchHasDragged) {
          e.preventDefault();
          e.stopPropagation();
          touchHasDragged = false;
        }
      }, true);
    }

    disconnectedCallback() {
      if (this._rafId) cancelAnimationFrame(this._rafId);
    }
  }

  customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Image Carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Auto Scroll"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 20,
      "max": 300,
      "step": 10,
      "unit": "px/s",
      "default": 80,
      "info": "Higher = faster scroll"
    },
    {
      "type": "header",
      "content": "Cards per Row"
    },
    {
      "type": "range",
      "id": "slides_to_show_desktop",
      "label": "Cards visible on Desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "slides_to_show_mobile",
      "label": "Cards visible on Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between cards",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "slide_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "carousel_height",
      "label": "Desktop height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "carousel_height_mobile",
      "label": "Mobile height",
      "min": 100,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section vertical padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Image 7"
    },
    {
      "type": "header",
      "content": "Click Link"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Slide click destination",
      "info": "Default: /collections/all"
    }
  ],
  "presets": [
