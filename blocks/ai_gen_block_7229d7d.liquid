{% doc %}
  @prompt
    Create a custom welcome banner block for the homepage. It should include a headline, a short welcome message/subtext, and a call-to-action button. The banner should be fully customizable with options for background color, text color, button color, and button link. It should be visually prominent and fit well with an apparel/merchandise brand aesthetic. It also needs to be able to offer a discount code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-welcome-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-welcome-banner__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    gap: 20px;
  }

  .ai-welcome-banner__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-welcome-banner__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
    opacity: 0.9;
  }

  .ai-welcome-banner__discount-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background-color: {{ block.settings.discount_bg_color }};
    color: {{ block.settings.discount_text_color }};
    padding: 12px 20px;
    border-radius: {{ block.settings.discount_border_radius }}px;
    font-size: {{ block.settings.discount_font_size }}px;
    font-weight: 600;
    border: 2px dashed {{ block.settings.discount_border_color }};
  }

  .ai-welcome-banner__discount-label-{{ ai_gen_id }} {
    opacity: 0.9;
  }

  .ai-welcome-banner__discount-code-{{ ai_gen_id }} {
    font-family: monospace;
    letter-spacing: 1px;
    font-size: {{ block.settings.discount_font_size | plus: 2 }}px;
  }

  .ai-welcome-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-welcome-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-welcome-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-welcome-banner__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-welcome-banner__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-welcome-banner__discount-{{ ai_gen_id }} {
      font-size: {{ block.settings.discount_font_size | times: 0.9 }}px;
    }

    .ai-welcome-banner__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-welcome-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-welcome-banner__container-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-welcome-banner__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-welcome-banner__subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if block.settings.show_discount and block.settings.discount_code != blank %}
      <div class="ai-welcome-banner__discount-{{ ai_gen_id }}">
        <span class="ai-welcome-banner__discount-label-{{ ai_gen_id }}">
          {{ block.settings.discount_label }}
        </span>
        <span class="ai-welcome-banner__discount-code-{{ ai_gen_id }}">
          {{ block.settings.discount_code }}
        </span>
      </div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a 
        href="{{ block.settings.button_link }}" 
        class="ai-welcome-banner__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Welcome banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Welcome to Font Boulderwear"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Discover our exclusive collection of Font Project T-shirts and apparel</p>"
    },
    {
      "type": "header",
      "content": "Discount code"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "default": "Use code:"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "WELCOME10"
    },
    {
      "type": "range",
      "id": "discount_font_size",
      "label": "Discount font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "discount_border_radius",
      "label": "Discount border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "discount_bg_color",
      "label": "Discount background",
      "default": "#FFF9E6"
    },
    {
      "type": "color",
      "id": "discount_text_color",
      "label": "Discount text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "discount_border_color",
      "label": "Discount border color",
      "default": "#FFD700"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Button vertical padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button horizontal padding",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#DC143C"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Banner style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "default": 1000
    }
  ],
  "presets": [
    {
      "name": "Welcome banner"
    }
  ]
}
{% endschema %}
