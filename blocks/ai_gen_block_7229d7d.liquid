{% doc %}
  @prompt
    Create a custom welcome banner block for the homepage. It should include a headline, a short welcome message/subtext, and a call-to-action button. The banner should be fully customizable with options for background color, text color, button color, and button link. It should be visually prominent and fit well with an apparel/merchandise brand aesthetic. It also needs to be able to offer a discount code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-welcome-banner-{{ ai_gen_id }} {
    display: block;
    width: 100vw !important;
    max-width: 100vw !important;
    position: relative !important;
    left: 50% !important;
    right: 50% !important;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.6)), url("{{ 'bouldering_promo_bg.png' | asset_url }}");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    padding: 90px 20px !important;
    text-align: center;
    box-sizing: border-box !important;
  }

  .ai-welcome-banner__container-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    background: rgba(18, 18, 18, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    border-radius: 24px;
    padding: 60px 40px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(211, 47, 47, 0.25);
    position: relative;
    overflow: hidden;
  }

  .ai-welcome-banner__container-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 150px;
    background: radial-gradient(circle, rgba(211, 47, 47, 0.25) 0%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
  }

  .ai-welcome-banner__headline-{{ ai_gen_id }} {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .ai-welcome-banner__subtext-{{ ai_gen_id }} {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #cccccc;
    margin: 0;
    line-height: 1.6;
    max-width: 650px;
  }

  .ai-welcome-banner__discount-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(211, 47, 47, 0.12);
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 600;
    border: 1.5px dashed #d32f2f;
    cursor: pointer;
    transition: all 0.3s ease;
    user-select: none;
  }

  .ai-welcome-banner__discount-{{ ai_gen_id }}:hover {
    background: rgba(211, 47, 47, 0.25);
    border-color: #ff4d4d;
    transform: scale(1.03);
    box-shadow: 0 4px 20px rgba(211, 47, 47, 0.3);
  }

  .ai-welcome-banner__discount-label-{{ ai_gen_id }} {
    color: #b0b0b0;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-welcome-banner__discount-code-{{ ai_gen_id }} {
    font-family: inherit;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #ff4d4d;
    font-size: 1.1rem;
  }

  .ai-welcome-banner__copy-icon {
    font-size: 0.85rem;
    margin-left: 4px;
    opacity: 0.8;
  }

  .ai-welcome-banner__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 40px;
    background-color: #d32f2f;
    color: #ffffff;
    text-decoration: none;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(211, 47, 47, 0.35);
  }

  .ai-welcome-banner__button-{{ ai_gen_id }}:hover {
    background-color: #ffffff;
    color: #d32f2f;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.25);
  }

  @media screen and (max-width: 749px) {
    .ai-welcome-banner__container-{{ ai_gen_id }} {
      padding: 36px 20px;
      border-radius: 16px;
    }
  }
{% endstyle %}

<div class="ai-welcome-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-welcome-banner__container-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-welcome-banner__headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-welcome-banner__subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if block.settings.show_discount and block.settings.discount_code != blank %}
      <div 
        class="ai-welcome-banner__discount-{{ ai_gen_id }}"
        onclick="navigator.clipboard.writeText('{{ block.settings.discount_code }}'); this.querySelector('.ai-welcome-banner__discount-label-{{ ai_gen_id }}').textContent = 'COPIED!'; setTimeout(() => this.querySelector('.ai-welcome-banner__discount-label-{{ ai_gen_id }}').textContent = '{{ block.settings.discount_label }}', 2500);"
        title="Click to copy discount code"
      >
        <span class="ai-welcome-banner__discount-label-{{ ai_gen_id }}">
          {{ block.settings.discount_label }}
        </span>
        <span class="ai-welcome-banner__discount-code-{{ ai_gen_id }}">
          {{ block.settings.discount_code }}
        </span>
        <span class="ai-welcome-banner__copy-icon">📋</span>
      </div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a 
        href="{{ block.settings.button_link | default: 'shopify://collections/all' }}" 
        class="ai-welcome-banner__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Welcome banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Welcome to Font Boulderwear"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Discover our exclusive collection of Font Project T-shirts and apparel</p>"
    },
    {
      "type": "header",
      "content": "Discount code"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "default": "Use code:"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "WELCOME10"
    },
    {
      "type": "range",
      "id": "discount_font_size",
      "label": "Discount font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "discount_border_radius",
      "label": "Discount border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "discount_bg_color",
      "label": "Discount background",
      "default": "#FFF9E6"
    },
    {
      "type": "color",
      "id": "discount_text_color",
      "label": "Discount text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "discount_border_color",
      "label": "Discount border color",
      "default": "#FFD700"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Button vertical padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button horizontal padding",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#DC143C"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Banner style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "default": 1000
    }
  ],
  "presets": [
    {
      "name": "Welcome banner"
    }
  ]
}
{% endschema %}
